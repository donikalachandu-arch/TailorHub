# ===============================================
# TailorHub Backend Production Environment Config
# ===============================================

NODE_ENV=production
PORT=5000
JWT_SECRET=super_secret_tailorhub_jwt_key_change_in_production_2026

# --- Database Options ---
# 1. PostgreSQL (Supabase / Render Postgres / Neon)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. SQLite local fallback (if DATABASE_URL is not set)
# DATABASE_URL=file:./tailorhub.db

# --- Cloud Storage Options (Supabase Storage / S3 / Cloudinary) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=tailorhub-records

# --- Frontend CORS URL ---
FRONTEND_URL=https://your-tailorhub-app.vercel.app
